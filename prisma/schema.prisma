generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  lastName String
  email    String  @unique
  password String
  role     Role    @default(USER)
  active   Boolean @default(true)

  courses             Course[]
  courseSubscriptions CourseSubscription[]
  subscriptions       UserSubscription[]   @relation("UserSubscriber")
  subscribers         UserSubscription[]   @relation("UserSubscribed")
  cards               Card[]
  summaries           Summary[]
}

model Subject {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  active      Boolean @default(true)

  courses Course[]
  topics  Topic[]
}

model Course {
  id     Int     @id @default(autoincrement())
  active Boolean @default(true)

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])

  courseSubscriptions CourseSubscription[]

  @@unique([authorId, subjectId])
}

model CourseSubscription {
  id     Int     @id @default(autoincrement())
  active Boolean @default(true)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  subscriberId Int
  subscriber   User @relation(fields: [subscriberId], references: [id])

  @@unique([subscriberId, courseId])
}

model UserSubscription {
  id     Int     @id @default(autoincrement())
  active Boolean @default(true)

  subscriberId Int
  subscriber   User @relation("UserSubscriber", fields: [subscriberId], references: [id])

  authorId Int
  author   User @relation("UserSubscribed", fields: [authorId], references: [id])

  @@unique([subscriberId, authorId])
}

model Topic {
  id     Int     @id @default(autoincrement())
  name   String
  active Boolean @default(true)

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])

  summaries Summary[]
  cards     Card[]
}

model Summary {
  id      Int      @id @default(autoincrement())
  title   String
  content String
  date    DateTime @default(now())
  active  Boolean  @default(true)

  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id])

  authorId Int
  author   User @relation(fields: [authorId], references: [id])
}

model Card {
  id       Int     @id @default(autoincrement())
  question String
  answer   String
  active   Boolean @default(true)

  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id])

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  hints Hint[]
}

model Hint {
  id      Int     @id @default(autoincrement())
  content String
  active  Boolean @default(true)

  cardId Int
  card   Card @relation(fields: [cardId], references: [id])
}
