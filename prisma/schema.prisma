generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Subject {
  id          Int @id @default(autoincrement())
  nombre      String
  descripcion String 
}
model User {
  id       Int @id @default(autoincrement())
  nombre   String
  apellido String
  email    String
  password String
}
